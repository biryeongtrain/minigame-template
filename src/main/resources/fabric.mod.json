{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "Minigame Template",
  "description": "Server-side minigame starter using the Semion TD library stack.",
  "authors": ["biryeongtrain"],
  "contact": {
    "sources": "https://github.com/biryeongtrain/minigame-template",
    "issues": "https://github.com/biryeongtrain/minigame-template/issues"
  },
  "license": "All-Rights-Reserved",
  "environment": "server",
  "entrypoints": {
    "main": ["kim.biryeong.minigame.MinigameTemplate"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "java": ">=21",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "sgui": "*",
    "bil": "*",
    "polymer-core": "*",
    "polymer-networking": "*",
    "polymer-resource-pack": "*",
    "polymer-virtual-entity": "*",
    "placeholder-api": ">=2.7.2+1.21.8",
    "sidebar-api": ">=0.5.1+1.21.1",
    "factorytools": ">=0.7.5+1.21.8",
    "minigamelib": ">=1.0.2+1.21.8",
    "apel": "=0.1.5+1.21.8"
  }
}
